{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Film Storyboard Schema",
  "type": "object",
  "required": [
    "project",
    "characters",
    "shots"
  ],
  "properties": {
    "project": {
      "type": "object",
      "required": [
        "title",
        "narration_language",
        "subtitle_language",
        "target_duration_seconds",
        "aspect_ratios",
        "visual_style"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "narration_language": {
          "type": "string"
        },
        "subtitle_language": {
          "type": "string"
        },
        "target_duration_seconds": {
          "type": "number",
          "minimum": 60,
          "maximum": 90
        },
        "aspect_ratios": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "contains": {
            "const": "16:9"
          },
          "minItems": 2
        },
        "visual_style": {
          "type": "string"
        }
      }
    },

    "characters": {
      "type": "object",
      "required": [
        "father",
        "daughter"
      ],
      "properties": {
        "father": {
          "$ref": "#/$defs/character"
        },
        "daughter": {
          "$ref": "#/$defs/character"
        }
      }
    },

    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/shot"
      }
    }
  },

  "$defs": {
    "character": {
      "type": "object",
      "required": [
        "description",
        "use_real_likeness"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "use_real_likeness": {
          "type": "boolean"
        }
      }
    },

    "shot": {
      "type": "object",
      "required": [
        "id",
        "duration_seconds",
        "narration_amharic",
        "subtitle_english",
        "motion_prompt",
        "music_mood"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 1
        },
        "narration_amharic": {
          "type": "string"
        },
        "subtitle_english": {
          "type": "string"
        },
        "visual_prompt": {
          "type": "string"
        },
        "visual_type": {
          "type": "string"
        },
        "on_screen_text": {
          "type": "string"
        },
        "motion_prompt": {
          "type": "string"
        },
        "music_mood": {
          "type": "string"
        }
      },

      "oneOf": [
        {
          "required": [
            "visual_prompt"
          ]
        },
        {
          "required": [
            "visual_type",
            "on_screen_text"
          ]
        }
      ]
    }
  }
}